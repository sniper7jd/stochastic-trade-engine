# Copy to .env for local runs (never commit .env).
# On Streamlit Community Cloud, add the same keys under App settings → Secrets.

ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key

# Equity data feed for streamlit_app.py (default: iex — works on free Alpaca).
# Free/basic keys cannot query recent SIP. Only set sip / delayed_sip if entitled.
# ALPACA_DATA_FEED=iex
